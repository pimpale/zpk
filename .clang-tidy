Checks: >
  -*,
  readability-identifier-naming

CheckOptions:
  # --- functions & data: snake_case -------------------------------------
  readability-identifier-naming.FunctionCase:            lower_case
  readability-identifier-naming.VariableCase:            lower_case
  readability-identifier-naming.ParameterCase:           lower_case
  readability-identifier-naming.MemberCase:              lower_case
  readability-identifier-naming.StaticVariableCase:      lower_case

  # --- file/translation-unit globals: g_ prefix -------------------------
  readability-identifier-naming.GlobalVariableCase:      lower_case
  readability-identifier-naming.GlobalVariablePrefix:    'g_'
  # ...but file-scope constants are SHOUTY, no prefix
  readability-identifier-naming.GlobalConstantCase:      UPPER_CASE
  readability-identifier-naming.StaticConstantCase:      UPPER_CASE

  # --- types: PascalCase ------------------------------------------------
  readability-identifier-naming.StructCase:              CamelCase
  readability-identifier-naming.UnionCase:               CamelCase
  readability-identifier-naming.EnumCase:                CamelCase
  readability-identifier-naming.TypedefCase:             CamelCase
  # generated container instantiations keep their template-ish names
  readability-identifier-naming.StructIgnoredRegexp:     '^(vec|llrb|llrbset)_.*'
  readability-identifier-naming.UnionIgnoredRegexp:      '^(vec|llrb|llrbset)_.*'
  readability-identifier-naming.EnumIgnoredRegexp:       '^(vec|llrb|llrbset)_.*'
  readability-identifier-naming.TypedefIgnoredRegexp:    '^(vec|llrb|llrbset)_.*'

  # --- constants & macros: SHOUTY ---------------------------------------
  readability-identifier-naming.EnumConstantCase:        UPPER_CASE
  readability-identifier-naming.MacroDefinitionCase:     UPPER_CASE
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^[a-z0-9_]+_h_INCLUDED$'
