# rustfmt-flavored C. Everything not listed here comes from LLVM.
BasedOnStyle: LLVM
Language: Cpp

ColumnLimit: 100
IndentWidth: 2
ContinuationIndentWidth: 2
UseTab: Never

# The rustfmt wrapping rule: fit on one line, or give every item its own line
# with the closing bracket outdented onto a line of its own.
AlignAfterOpenBracket: BlockIndent
BinPackArguments: false
BinPackParameters: OnePerLine
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# rustfmt indents continuations, it never column-aligns them.
AlignOperands: DontAlign
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignEscapedNewlines: DontAlign
BreakBeforeBinaryOperators: NonAssignment

# Bodies always get real lines and real braces.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
InsertBraces: true
IndentCaseLabels: true

PointerAlignment: Right
InsertNewlineAtEOF: true
SeparateDefinitionBlocks: Always
